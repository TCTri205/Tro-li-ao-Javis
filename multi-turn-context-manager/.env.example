# Database connection for Numeric SQL Tool
NUMERIC_SQL_DATABASE_URL=postgresql://app_user:app_password@localhost:54331/app_db

# LLM configuration
NUMERIC_SQL_LLM_PROVIDER=groq
LLM_MODE=javis-qwen   # grod / javis-qwen
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEYS=

# Javis Qwen configuration
JAVIS_QWEN_API_KEY=
JAVIS_QWEN_BASE_URL=https://llm-gateway-prd.project-athena.space/v1
JAVIS_QWEN_MODEL=javis-qwen3/Qwen3-14B-AWQ
JAVIS_QWEN_TIMEOUT=15.0


# Statement timeout in ms
NUMERIC_SQL_STATEMENT_TIMEOUT_MS=5000
